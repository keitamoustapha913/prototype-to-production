#!/usr/bin/env python3
"""Replay parser stdout for identical successful inputs during workflow tests."""

from hashlib import sha256
import os
from pathlib import Path
import subprocess
import sys
from tempfile import TemporaryDirectory


def main():
    repository = Path(__file__).resolve().parents[3]
    parser = repository / 'scripts' / 'parse_mermaid.mjs'
    args = sys.argv[1:]
    real_node = os.environ['P2P_TEST_REAL_NODE']
    if args != [str(parser)]:
        os.execv(real_node, [real_node, *args])

    data = sys.stdin.buffer.read()
    cache = Path(os.environ['P2P_TEST_MERMAID_CACHE'])
    entry = cache / sha256(data).hexdigest()
    try:
        output = entry.read_bytes()
    except FileNotFoundError:
        result = subprocess.run([real_node, *args], input=data, capture_output=True)
        sys.stdout.buffer.write(result.stdout)
        sys.stderr.buffer.write(result.stderr)
        if result.returncode == 0 and not result.stderr:
            # Publish complete entries even if two CLI processes parse at once.
            with TemporaryDirectory(dir=cache) as temporary:
                pending = Path(temporary) / 'stdout'
                pending.write_bytes(result.stdout)
                pending.replace(entry)
        return result.returncode
    sys.stdout.buffer.write(output)
    return 0


if __name__ == '__main__':
    sys.exit(main())
